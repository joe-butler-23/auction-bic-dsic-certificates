def t1Int (i j k : Nat) : Int :=
  match k with
  | 0 => Int.ofNat i * qSum1Int i j 0 + Int.ofNat j * qSum2Int i j 0 - uVertInt i j
  | _ => Int.ofNat (i + 1) * qSum1Int i j 1 + Int.ofNat (j + 1) * qSum2Int i j 1 - uVertInt (i + 1) (j + 1)

def bicFeasCheck : Bool :=
  range6All fun i1 => range6All fun j1 => range2All fun k1 =>
    range6All fun i2 => range6All fun j2 => range2All fun k2 =>
      let a := q11Int i1 j1 k1 i2 j2 k2
      let b := q11Int i2 j2 k2 i1 j1 k1
      decide (0 ≤ a) && decide (a + b ≤ 18)

def bicRowSumCheck : Bool :=
  range6All fun i1 => range6All fun j1 => range2All fun k1 =>
    decide (t72Sum (t72Get qMatData i1 j1 k1) = qSum1Int i1 j1 k1)

def bicGradCheck : Bool :=
  range6All fun i => range6All fun j =>
    decide (qSum1Int i j 0 = uVertInt (i + 1) j - uVertInt i j) &&
    decide (qSum2Int i j 0 = uVertInt i (j + 1) - uVertInt i j) &&
    decide (qSum1Int i j 1 = uVertInt (i + 1) (j + 1) - uVertInt i (j + 1)) &&
    decide (qSum2Int i j 1 = uVertInt (i + 1) (j + 1) - uVertInt (i + 1) j)

def bicVertIRCheck : Bool :=
  range7All fun i => range7All fun j => decide (0 ≤ uVertInt i j)

def bicVertICCheck : Bool :=
  range7All fun vi => range7All fun vj =>
    let uTrue := uVertInt vi vj
    range6All fun i => range6All fun j => range2All fun k =>
      let uRep := Int.ofNat vi * qSum1Int i j k + Int.ofNat vj * qSum2Int i j k - t1Int i j k
      decide (uRep ≤ uTrue)

def bicRevSum : Int :=
  range6Sum fun i => range6Sum fun j => range2Sum fun k => t1Int i j k

