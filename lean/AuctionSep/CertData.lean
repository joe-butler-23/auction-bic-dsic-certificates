namespace AuctionSep.CertData


structure P2 (α : Type) where
  a0 : α
  a1 : α

def P2.get {α : Type} (p : P2 α) (i : Nat) : α :=
  match i with
  | 0 => p.a0
  | _ => p.a1

def P2.all {α : Type} (p : P2 α) (f : Nat → α → Bool) : Bool :=
  f 0 p.a0 && f 1 p.a1

def P2.sum (p : P2 Int) : Int := p.a0 + p.a1

structure Q4 (α : Type) where
  a0 : α
  a1 : α
  a2 : α
  a3 : α

def Q4.get {α : Type} (q : Q4 α) (i : Nat) : α :=
  match i with
  | 0 => q.a0
  | 1 => q.a1
  | 2 => q.a2
  | _ => q.a3

def Q4.all {α : Type} (q : Q4 α) (f : Nat → α → Bool) : Bool :=
  f 0 q.a0 && f 1 q.a1 && f 2 q.a2 && f 3 q.a3

def Q4.sum (q : Q4 Int) : Int := q.a0 + q.a1 + q.a2 + q.a3

def range4All (f : Nat → Bool) : Bool :=
  f 0 && f 1 && f 2 && f 3

def range4Sum (f : Nat → Int) : Int :=
  f 0 + f 1 + f 2 + f 3

structure S6 (α : Type) where
  a0 : α
  a1 : α
  a2 : α
  a3 : α
  a4 : α
  a5 : α

def S6.get {α : Type} (s : S6 α) (i : Nat) : α :=
  match i with
  | 0 => s.a0
  | 1 => s.a1
  | 2 => s.a2
  | 3 => s.a3
  | 4 => s.a4
  | _ => s.a5

def range6All (f : Nat → Bool) : Bool :=
  f 0 && f 1 && f 2 && f 3 && f 4 && f 5

def range6Sum (f : Nat → Int) : Int :=
  f 0 + f 1 + f 2 + f 3 + f 4 + f 5

def range2All (f : Nat → Bool) : Bool := f 0 && f 1
def range2Sum (f : Nat → Int) : Int := f 0 + f 1

structure S7 (α : Type) where
  a0 : α
  a1 : α
  a2 : α
  a3 : α
  a4 : α
  a5 : α
  a6 : α

def S7.get {α : Type} (s : S7 α) (i : Nat) : α :=
  match i with
  | 0 => s.a0
  | 1 => s.a1
  | 2 => s.a2
  | 3 => s.a3
  | 4 => s.a4
  | 5 => s.a5
  | _ => s.a6

def range7All (f : Nat → Bool) : Bool :=
  f 0 && f 1 && f 2 && f 3 && f 4 && f 5 && f 6

abbrev T72 (α : Type) := S6 (S6 (P2 α))

def t72Get {α : Type} (t : T72 α) (i j k : Nat) : α :=
  P2.get (S6.get (S6.get t i) j) k

def t72Sum (t : T72 Int) : Int :=
  range6Sum fun i => range6Sum fun j => P2.sum (S6.get (S6.get t i) j)

