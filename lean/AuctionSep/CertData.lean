def a1Ext (si sj i j : Nat) : Int :=
  if i < 4 then m16Get (m16Get a1Data si sj) i j else 0

def a2Ext (si sj i j : Nat) : Int :=
  if j < 4 then m16Get (m16Get a2Data si sj) i j else 0

def dualNonnegCheck : Bool :=
  range4All fun si => range4All fun sj =>
    range4All fun i => range4All fun j =>
      decide (0 ≤ m16Get (m16Get a1Data si sj) i j) && decide (0 ≤ m16Get (m16Get a2Data si sj) i j)

def dualDivCheck : Bool :=
  range4All fun si => range4All fun sj =>
    range4All fun i => range4All fun j =>
      let d1 := 4 * (a1Ext si sj i j - a1Ext si sj (i + 1) j)
      let d2 := 4 * (a2Ext si sj i j - a2Ext si sj i (j + 1))
      decide (d1 + d2 ≤ 1920)

def max3Int (a b c : Int) : Int := max a (max b c)

def phi1Scaled (ia ja u ib jb : Nat) : Int :=
  let aL := a1Ext ib jb ia ja
  let aR := a1Ext ib jb (ia + 1) ja
  480 * Int.ofNat (4 * ia + u) - (Int.ofNat (4 - u) * aL + Int.ofNat u * aR)

def phi2Scaled (ia ja u ib jb : Nat) : Int :=
  let aL := a2Ext ib jb ia ja
  let aR := a2Ext ib jb ia (ja + 1)
  480 * Int.ofNat (4 * ja + u) - (Int.ofNat (4 - u) * aL + Int.ofNat u * aR)

def dualCellSum (i1 j1 i2 j2 : Nat) : Int :=
  let v1 := fun u1 u2 => max3Int 0 (phi1Scaled i1 j1 u1 i2 j2) (phi1Scaled i2 j2 u2 i1 j1)
  let v2 := fun u1 u2 => max3Int 0 (phi2Scaled i1 j1 u1 i2 j2) (phi2Scaled i2 j2 u2 i1 j1)
  range4Sum fun u1 => range4Sum fun u2 =>
    (v1 u1 u2 + v1 u1 (u2 + 1) + v1 (u1 + 1) u2 + v1 (u1 + 1) (u2 + 1)) +
    (v2 u1 u2 + v2 u1 (u2 + 1) + v2 (u1 + 1) u2 + v2 (u1 + 1) (u2 + 1))

def dualTotalSum : Int :=
  range4Sum fun i1 => range4Sum fun j1 =>
    range4Sum fun i2 => range4Sum fun j2 =>
      dualCellSum i1 j1 i2 j2

